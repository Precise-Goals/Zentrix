{
  "name": "zentrix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"vite,server\" --prefix-colors \"cyan,magenta\" \"vite --port 3000\" \"bun run --watch server/index.ts\"",
    "dev:server": "bun run --watch server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "bun run server/index.ts",
    "compile": "cd contracts && bun x hardhat compile",
    "test:contracts": "cd contracts && bun x hardhat test",
    "lint:contracts": "cd contracts && bun x solhint \"contracts/**/*.sol\"",
    "deploy:testnet": "cd contracts && bun x hardhat run scripts/deploy.ts --network mstTestnet"
  },
  "dependencies": {
    "@mstblockchain/mst-sdk": "^1.0.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^2.0.59",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "firebase": "^10.13.1",
    "framer-motion": "^13.4.4",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^20.16.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^16.0.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.4",
    "vite": "^5.4.10"
  }
}
